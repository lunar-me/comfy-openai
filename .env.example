# ComfyUI endpoint (user-configured)
COMFY_URL=http://localhost:8188

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=local-key

# Where generated images are saved and served from
OUTPUT_DIR=output

# API base URL used by the test scripts (must point at the API server).
# Scripts append /v1 automatically if missing, so both forms work:
#   BASE_URL=http://localhost:8000        (scripts -> http://localhost:8000/v1)
#   BASE_URL=http://localhost:8000/v1     (scripts -> http://localhost:8000/v1)
BASE_URL=http://localhost:8000

# Default model id used by the generation/edit test scripts
MODEL=flux

# Path to the model registry JSON (model name -> workflow + node map).
# Add/edit entries here to register new workflows without code changes.
WORKFLOW_REGISTRY=workflows/models.json
